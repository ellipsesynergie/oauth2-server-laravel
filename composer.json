{
    "name": "ellipsesynergie/oauth2-server-laravel",
    "description": "An OAuth 2.0 bridge for Laravel and Lumen",
    "keywords": ["oauth2", "oauth", "server", "api", "laravel", "lumen"],
    "license": "MIT",
    "authors": [
        {
            "name": "Luca Degasperi",
            "email": "packages@lucadegasperi.com"
        },
        {
            "name": "Vincent Klaiber",
            "email": "hello@vinkla.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ellipsesynergie/league-oauth2-server"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0",
        "illuminate/console": "^10.0",
        "illuminate/http": "^10.0",
        "illuminate/config": "^10.0",
        "league/oauth2-server": "4.5.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0",
        "phpunit/phpunit": "^9.0",
        "phpspec/phpspec": "^7.3",
        "mockery/mockery": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "LucaDegasperi\\OAuth2Server\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LucaDegasperi\\OAuth2Server\\Tests\\": "tests"
        },
        "classmap": [
            "database"
        ],
        "files": [
            "tests/AbstractTestCase.php",
            "tests/integration/AbstractDBTestCase.php"
        ]
    },
    "scripts": {
        "test:unit": "phpunit --colors=always",
        "test:spec": "phpspec run"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
